</head>
<body>

  <h1>🎬 영화 티어리스트</h1>

  <!-- 상단 컨트롤 영역 추가 -->
  <div class="controls">
    <button class="btn-secondary" onclick="exportData()">파일로 저장(백업)</button>
    <button class="btn-secondary" onclick="document.getElementById('fileInput').click()">파일 불러오기</button>
    <input type="file" id="fileInput" style="display:none" accept=".json" onchange="importData(event)">
  </div>

  <div class="tier-table" id="tierTable"></div>

  <footer>데이터는 브라우저에 자동 저장되나, 로그아웃 시 삭제될 수 있으니 백업 기능을 활용하세요.</footer>

  <script>
    const TIERS = ['A', 'B', 'C', 'D'];

    function loadData() {
      try {
        const saved = localStorage.getItem('movieTierlist');
        return saved ? JSON.parse(saved) : { A:[], B:[], C:[], D:[] };
      } catch {
        return { A:[], B:[], C:[], D:[] };
      }
    }

    function saveData(data) {
      localStorage.setItem('movieTierlist', JSON.stringify(data));
    }

    // [추가] 데이터를 JSON 파일로 다운로드
    function exportData() {
      const data = loadData();
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'movie_tierlist_backup.json';
      a.click();
      URL.revokeObjectURL(url);
    }

    // [추가] JSON 파일을 읽어와서 데이터 복구
    function importData(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = JSON.parse(e.target.result);
          if (confirm('기존 데이터를 덮어쓰고 파일을 불러올까요?')) {
            saveData(data);
            render(data);
          }
        } catch (err) {
          alert('올바른 파일이 아닙니다.');
        }
      };
      reader.readAsText(file);
    }

    function createTag(title, tier, data) {
      const tag = document.createElement('span');
      tag.className = 'movie-tag';
      const text = document.createElement('span');
      text.textContent = title;
      const btn = document.createElement('button');
      btn.textContent = '✕';
      btn.onclick = () => {
        data[tier] = data[tier].filter(t => t !== title);
        saveData(data);
        render(data);
      };
      tag.appendChild(text);
      tag.appendChild(btn);
      return tag;
    }

    function render(data) {
      const table = document.getElementById('tierTable');
      table.innerHTML = '';

      TIERS.forEach(tier => {
        const row = document.createElement('div');
        row.className = 'tier-row';
        const label = document.createElement('div');
        label.className = `tier-label tier-${tier}`;
        label.textContent = tier;
        const content = document.createElement('div');
        content.className = 'tier-content';
        const list = document.createElement('div');
        list.className = 'movie-list';

        if (!data[tier] || data[tier].length === 0) {
          const empty = document.createElement('span');
          empty.className = 'empty-msg';
          empty.textContent = '아직 추가된 영화가 없습니다.';
          list.appendChild(empty);
        } else {
          data[tier].forEach(title => {
            list.appendChild(createTag(title, tier, data));
          });
        }

        const inputRow = document.createElement('div');
        inputRow.className = 'input-row';
        const input = document.createElement('input');
        input.type = 'text';
        input.placeholder = `${tier}티어 입력`;
        const addBtn = document.createElement('button');
        addBtn.textContent = '추가';

        function addMovie() {
          const title = input.value.trim();
          if (!title) return;
          if (!data[tier]) data[tier] = [];
          if (data[tier].includes(title)) {
            alert('이미 등록된 영화입니다.');
            return;
          }
          data[tier].push(title);
          saveData(data);
          render(data);
        }

        addBtn.onclick = addMovie;
        input.onkeydown = (e) => { if (e.key === 'Enter') addMovie(); };

        inputRow.appendChild(input);
        inputRow.appendChild(addBtn);
        content.appendChild(list);
        content.appendChild(inputRow);
        row.appendChild(label);
        row.appendChild(content);
        table.appendChild(row);
      });
    }

    render(loadData());
  </script>
</body>
</html>
