      padding: 8px 12px;
      font-size: 0.9rem;
      outline: none;
      background: #fafafa;
      color: #222;
    }
    .storage-input input:focus { border-color: #888; background: #fff; }
    .storage-input button {
      border: none;
      border-radius: 6px;
