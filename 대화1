    .movie-tag { display: inline-flex; align-items: center; gap: 6px; background: #f0f0f0; border-radius: 6px; padding: 5px 10px; font-size: 0.9rem; color: #333; }
    .movie-tag button { background: none; border: none; cursor: pointer; color: #999; font-size: 1rem; padding: 0; }
    .movie-tag button:hover { color: #e05c5c; }
    .input-row { display: flex; gap: 8px; }
    .input-row input { flex: 1; border: 1px solid #ddd; border-radius: 6px; padding: 6px 10px; font-size: 0.88rem; outline: none; background: #fafafa; }
    .input-row button { border: none; border-radius: 6px; padding: 6px 14px; cursor: pointer; background: #444; color: #fff; }
