      box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }
    .tier-row {
      display: flex;
      align-items: stretch;
      border-bottom: 1px solid #e8e8e8;
    }
    .tier-row:last-child { border-bottom: none; }

    .tier-label {
      width: 64px;
      min-width: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 800;
      color: #fff;
      user-select: none;
    }
    .tier-A { background: #e05c5c; }
    .tier-B { background: #e09a3a; }
    .tier-C { background: #6aab6a; }
    .tier-D { background: #5b8fd4; }

    .tier-content {
      flex: 1;
      padding: 12px 14px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-content: flex-start;
      min-height: 60px;
    }
    .tier-content.drag-over { background: #f3f8ff; }

    .empty-msg {
      font-size: 0.82rem;
      color: #bbb;
      align-self: center;
    }

    footer {
      text-align: center;
      margin-top: 24px;
      font-size: 0.78rem;
      color: #bbb;
    }
  </style>
</head>
<body>

  <h1>🎬 영화 티어리스트</h1>

  <!-- 보관함 -->
  <div class="storage">
    <h2>📦 보관함 — 영화를 추가한 뒤 아래 등급으로 끌어다 놓으세요</h2>
    <div class="storage-input">
      <input type="text" id="movieInput" placeholder="영화 제목을 입력하세요" maxlength="60" />
      <button id="addBtn">추가</button>
    </div>
    <div class="storage-list" id="storageList" data-tier="storage"></div>
  </div>

  <!-- 티어 표 -->
  <div class="tier-table" id="tierTable"></div>

  <footer>데이터는 이 브라우저에 자동 저장됩니다.</footer>

  <script>
    const TIERS = ['A', 'B', 'C', 'D'];

    // 데이터 불러오기 (storage = 보관함)
    function loadData() {
      try {
        return JSON.parse(localStorage.getItem('movieTierlist2'))
          || { storage:[], A:[], B:[], C:[], D:[] };
      } catch {
        return { storage:[], A:[], B:[], C:[], D:[] };
      }
    }

    function saveData(data) {
      localStorage.setItem('movieTierlist2', JSON.stringify(data));
    }

    let dragInfo = null; // { title, from }

    // 영화 태그 만들기
    function createTag(title, from, data) {
      const tag = document.createElement('span');
      tag.className = 'movie-tag';
      tag.draggable = true;

      const text = document.createElement('span');
      text.textContent = title;

      const btn = document.createElement('button');
      btn.textContent = '✕';
      btn.title = '삭제';
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        data[from] = data[from].filter(t => t !== title);
        saveData(data);
        render(data);
      });

      // 드래그 시작
      tag.addEventListener('dragstart', () => {
        dragInfo = { title, from };
        tag.classList.add('dragging');
      });
      tag.addEventListener('dragend', () => {
        tag.classList.remove('dragging');
      });

      tag.appendChild(text);
      tag.appendChild(btn);
      return tag;
    }

    // 드롭 받는 영역 설정
    function setupDropZone(zone, targetKey, data) {
      zone.addEventListener('dragover', (e) => {
        e.preventDefault();
        zone.classList.add('drag-over');
      });
      zone.addEventListener('dragleave', () => {
        zone.classList.remove('drag-over');
      });
      zone.addEventListener('drop', (e) => {
        e.preventDefault();
        zone.classList.remove('drag-over');
        if (!dragInfo) return;

        const { title, from } = dragInfo;
        if (from === targetKey) { dragInfo = null; return; }
        if (data[targetKey].includes(title)) { dragInfo = null; return; }

        // 기존 위치에서 제거 후 새 위치에 추가
        data[from] = data[from].filter(t => t !== title);
        data[targetKey].push(title);
        saveData(data);
        render(data);
        dragInfo = null;
      });
    }

    function render(data) {
      // 보관함
      const storageList = document.getElementById('storageList');
      storageList.innerHTML = '';
      if (data.storage.length === 0) {
        const empty = document.createElement('span');
        empty.className = 'empty-msg';
        empty.textContent = '추가한 영화가 여기에 담깁니다.';
        storageList.appendChild(empty);
      } else {
        data.storage.forEach(title => {
          storageList.appendChild(createTag(title, 'storage', data));
        });
      }
      setupDropZone(storageList, 'storage', data);

      // 티어 표
      const table = document.getElementById('tierTable');
      table.innerHTML = '';
      TIERS.forEach(tier => {
        const row = document.createElement('div');
        row.className = 'tier-row';

        const label = document.createElement('div');
        label.className = `tier-label tier-${tier}`;
        label.textContent = tier;

        const content = document.createElement('div');
        content.className = 'tier-content';
        content.dataset.tier = tier;

        if (data[tier].length === 0) {
          const empty = document.createElement('span');
          empty.className = 'empty-msg';
          empty.textContent = '여기로 영화를 끌어다 놓으세요';
          content.appendChild(empty);
        } else {
          data[tier].forEach(title => {
            content.appendChild(createTag(title, tier, data));
          });
        }
        setupDropZone(content, tier, data);

        row.appendChild(label);
        row.appendChild(content);
        table.appendChild(row);
      });
    }

    // 보관함에 영화 추가
    const data = loadData();
    const input = document.getElementById('movieInput');
    const addBtn = document.getElementById('addBtn');

    function addMovie() {
      const title = input.value.trim();
      if (!title) { input.focus(); return; }
      // 중복 확인 (모든 영역)
      const all = [...data.storage, ...data.A, ...data.B, ...data.C, ...data.D];
      if (all.includes(title)) {
        alert(`"${title}"은(는) 이미 추가되어 있습니다.`);
        input.select();
        return;
      }
      data.storage.push(title);
      saveData(data);
      render(data);
      input.value = '';
      input.focus();
    }

    addBtn.addEventListener('click', addMovie);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') addMovie(); });

    render(data);
  </script>
</body>
</html>
```

### 📝 사용 방법 (아주 쉬워요!)

1. 위 코드를 **전부 복사**해요. (맨 위 `<!DOCTYPE html>`부터 맨 아래 `</html>`까지)
2. **텍스트편집기**를 열어서 붙여넣어요.
3. **`영화티어리스트.html`** 이름으로 저장해요.
4. 저장한 파일을 **더블클릭**하면 사파리에서 열려요! 😊

